{
  "name": "app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,api -c blue,green \"vite\" \"tsx watch server/index.ts\"",
    "build": "tsc -b && tsc -p server/tsconfig.json && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "dev:web": "vite",
    "dev:tablet": "concurrently -k -n web,api -c blue,green \"vite --host\" \"tsx watch server/index.ts\""
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@google/genai": "^2.31.0",
    "@hono/node-server": "^2.1.5",
    "@react-three/drei": "^10.0.8",
    "@react-three/fiber": "^9.1.2",
    "@react-three/postprocessing": "^3.0.4",
    "dotenv": "^18.0.9",
    "hono": "^4.13.14",
    "perfect-freehand": "^1.2.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "three": "^0.170.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@types/three": "^0.170.0",
    "@vitejs/plugin-react": "^4.4.1",
    "concurrently": "^10.0.6",
    "eslint": "^9.25.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "tsx": "^4.23.15",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.30.1",
    "vite": "^6.3.5",
    "vitest": "^2.1.8"
  }
}
